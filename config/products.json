{
  "schema": 1,
  "policy": {
    "cn_collection": "region/cn",
    "cn_exclusion": "Remove any overlapping overseas predicate; quarantine non-subtractable predicates rather than adding NOT conditions.",
    "references": "Corroboration only. Shared CDNs, CAs, payment services and an entire ASN are not proof of product ownership.",
    "ru_domains": "Explicit Russian service identities only, never tld-ru/category-ru or ASN registration country.",
    "upstream_lineage": "Alternate file formats and mirrors are not independent votes. Domain categories are identity assertions, not geolocation votes."
