{
  "schema": 1,
  "version": "2026-11-special-v1",
  "policy": {
    "address_mode_not_route": true,
    "no_network_during_build": true,
    "iana_baseline": "Selected RFC-defined allocations, checked against frozen IANA registry when available; absence is reported",
    "optional_realip": "Only explicit endpoint matches. DLC role catalogues and derived DustinWin lists are one lineage, not independent votes."
  },
  "evidence": {
    "iana4": {
      "url": "https://www.iana.org/assignments/iana-ipv4-special-registry/",
      "semantics": "Registered special purpose, not a route action",
      "lineage": "IANA/IETF"
    },
    "iana6": {
      "url": "https://www.iana.org/assignments/iana-ipv6-special-registry/",
      "semantics": "Registered special purpose, not a route action",
      "lineage": "IANA/IETF"
    },
    "rfc1918": {
      "url": "https://www.rfc-editor.org/rfc/rfc1918",
      "semantics": "Private IPv4 address allocation",
      "lineage": "IANA/IETF"
    },
    "rfc4193": {
      "url": "https://www.rfc-editor.org/rfc/rfc4193",
      "semantics": "IPv6 unique-local allocation",
      "lineage": "IANA/IETF"
    },
    "rfc4291": {
      "url": "https://www.rfc-editor.org/rfc/rfc4291",
      "semantics": "IPv6 loopback, link-local and multicast",
      "lineage": "IANA/IETF"
    },
    "rfc1112": {
      "url": "https://www.rfc-editor.org/rfc/rfc1112",
      "semantics": "IPv4 multicast allocation",
      "lineage": "IANA/IETF"
    },
    "rfc3927": {
      "url": "https://www.rfc-editor.org/rfc/rfc3927",
      "semantics": "IPv4 link-local",
      "lineage": "IANA/IETF"
    },
    "rfc6761": {
      "url": "https://www.rfc-editor.org/rfc/rfc6761",
      "semantics": "localhost special-use name; .test/.example/.invalid not LAN services",
      "lineage": "IANA/IETF"
    },
    "rfc6762": {
      "url": "https://www.rfc-editor.org/rfc/rfc6762",
      "semantics": ".local multicast-DNS name; list does not implement mDNS",
      "lineage": "IANA/IETF"
    },
    "rfc8375": {
      "url": "https://www.rfc-editor.org/rfc/rfc8375",
      "semantics": ".home.arpa residential local namespace",
      "lineage": "IANA/IETF"
    },
    "rfc7050": {
      "url": "https://www.rfc-editor.org/rfc/rfc7050",
      "semantics": "ipv4only.arpa address answers used for Pref64 discovery",
      "lineage": "IANA/IETF"
    },
    "windows-ncsi": {
      "url": "https://learn.microsoft.com/en-us/troubleshoot/windows-server/networking/troubleshoot-ncsi-guidance",
      "semantics": "Exact NCSI DNS/HTTP connectivity-test endpoints",
      "lineage": "Microsoft"
    },
    "apple-network": {
      "url": "https://support.apple.com/en-us/101555",
      "semantics": "Apple explicitly documented connectivity, time and software-update hostnames",
      "lineage": "Apple"
    },
    "google-ntp": {
      "url": "https://developers.google.com/time/guides",
      "semantics": "Explicit time synchronization hostnames, not all Google domains",
      "lineage": "Google"
    },
    "webrtc-sample": {
      "url": "https://github.com/webrtc/samples/blob/gh-pages/src/content/peerconnection/trickle-ice/js/main.js",
      "semantics": "Published STUN endpoint in the WebRTC sample; no execution by this builder",
      "lineage": "WebRTC/Google"
    },
    "google-dns": {
      "url": "https://developers.google.com/speed/public-dns/docs/using",
      "semantics": "Google Public DNS resolver identities only",
      "lineage": "Google"
    },
    "cloudflare-dns": {
      "url": "https://developers.cloudflare.com/1.1.1.1/ip-addresses/",
      "semantics": "Cloudflare public resolver identities only",
      "lineage": "Cloudflare"
    },
    "cloudflare-doh": {
      "url": "https://developers.cloudflare.com/1.1.1.1/encryption/dns-over-https/",
      "semantics": "DNS over HTTPS endpoint identity",
      "lineage": "Cloudflare"
    },
    "dlc-private": {
      "url": "https://github.com/v2fly/domain-list-community/blob/master/data/private",
      "semantics": "Mixed community private list, audited against explicit local-purpose policy; not blindly copied",
      "lineage": "DLC/private"
    },
    "dlc-ntp": {
      "url": "https://github.com/v2fly/domain-list-community/blob/master/data/category-ntp",
      "semantics": "Community NTP endpoint role, does not prove real-IP is required by every endpoint",
      "lineage": "DLC/category-ntp"
    },
    "dlc-stun": {
      "url": "https://github.com/v2fly/domain-list-community/blob/master/data/category-stun",
      "semantics": "Community STUN endpoint role, not a whole-platform identity",
      "lineage": "DLC/category-stun"
    },
    "dustinwin": {
      "url": "https://github.com/DustinWin/ruleset_geodata/tree/mihomo-ruleset",
      "semantics": "Optional compatibility candidates derived from DLC and ShellCrash; not an independent vote",
      "lineage": "DLC+ShellCrash/DustinWin"
    },
    "surge": {
      "url": "https://manual.nssurge.com/book/understanding-surge/en/understanding-surge-en.pdf",
      "semantics": "Always-real-IP controls returned address mode, not traffic routing or a proof that every UDP service requires it",
      "lineage": "Surge"
    }
  },
